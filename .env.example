# DocEditor — configuration
#
# Every variable below is read by src/config.rs. Anything this service does not
# read has been removed rather than left to suggest a feature that does not
# exist (the previous file advertised auto-save, websocket and export knobs for
# a collaborative layer that was never built, plus DOCSTORE_URL/PDF_ENGINE_URL
# for outbound calls this service does not make).

# --- Required ---------------------------------------------------------------
# 5435 and not 5433: on the dev host, 5433 is another project's container which
# answers and then rejects the `ods` role, so the failure reads like broken code.
DATABASE_URL=postgres://ods:ods-dev-2026@127.0.0.1:5435/ods

# --- HTTP -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8087

# --- Logging ----------------------------------------------------------------
# Applied to the tracing subscriber. RUST_LOG, when set, takes precedence.
LOG_LEVEL=info

# --- Documents --------------------------------------------------------------
# Bounds both the HTTP payload and the document body itself.
MAX_DOCUMENT_SIZE_MB=10

# --- Events -----------------------------------------------------------------
# Leave REDPANDA_BROKERS unset ONLY to run without a broker: events are then
# dropped, and the service says so at WARN on startup.
REDPANDA_BROKERS=127.0.0.1:9092
REDPANDA_TOPIC=editor.events

# --- Authentication ---------------------------------------------------------
# Production: the OID RS256 public key, PEM, base64-encoded.
JWT_RSA_PUBLIC_KEY_B64=__NEEDS_HUMAN__
# Development only: accept HS256 with a shared secret instead.
JWT_ALLOW_HS256=false
JWT_SECRET=
JWT_ISSUER=https://oid.staging.orbusdigital.com
JWT_AUDIENCE=
